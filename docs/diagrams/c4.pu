#### C2. Container
@startuml

!include <c4/C4_Container.puml>

title Архитектура приложения СамСебеМеханик

Person(user, "Пользователь", "Пользователь системы")

System_Boundary(WebApp, "ВЕБ-приложение") {

    Container(frontend, "Frontend", "React")
    
    Container(backend, "Backend API", "Spring Boot (Java)", "REST API + WebSocket")

    Container(soapService, "SOAP Service", "Spring Boot", "SOAP API для чтения данных")

    ContainerDb(postgreSQL, "Main Database", "PostgreSQL", "Хранит пользователей, компоненты, изображения, связи, избранное")

    ContainerDb(mongoDB, "Version Storage", "MongoDB", "Хранит версии описаний компонентов")
}

System_Ext(kafka, "Kafka", "Брокер событий")

Person_Ext(soapClient, "SOAP клиент", "Тестовый клиент")

Rel(soapClient, soapService, "Вызывает")

Rel(user, frontend, "Использует")

Rel(soapService, postgreSQL, "Читает")

Rel(frontend, backend, "Использует", "HTTPS / JSON")
Rel(frontend, backend, "Подписывается на события", " (/ws, /topic/components)")

Rel(backend, postgreSQL, "Читает/Пишет")
Rel(backend, mongoDB, "Пишет")
Rel(backend, kafka, "Публикует/читает события")

@enduml

#### C3. Component
@startuml
!include <c4/C4_Component.puml>

title Ключевые бизнес-компоненты

Person(client, "Клиент (Frontend / API consumer)", "Использует REST API и WebSocket/STOMP")

Container_Boundary(backend, "Catalog Service (Spring Boot)") {

    Component(apiControllers, "REST Controllers", "Spring Web", "AutoComponentController, FavouriteController, LeftMenuController, UserController, HealthController")

    Component(componentService, "AutoComponentServiceImpl", "Service", "CRUD автокомпонентов + формирование событий")

    Component(favouriteService, "FavouriteServiceImpl", "Service", "Добавление и получение избранного")

    Component(outboxService, "OutboxService", "Service", "Запись ComponentUpdatedEvent в outbox_event")

    Component(outboxRelay, "OutboxRelayPublisher", "Scheduled Kafka Publisher", "Читает outbox_event и публикует в Kafka topic auto-component-updated")

    Component(createdProducer, "ComponentEventProducer", "Kafka Producer", "Публикация ComponentCreatedEvent в topic component-events")

    Component(createdConsumer, "ComponentEventConsumer", "Kafka Listener","Читает component-events и отправляет в WebSocket /topic/components")

    Component(versionService, "ComponentVersionService", "Kafka Listener + Mongo Service", "Читает auto-component-updated и сохраняет версии описаний")

    Component(wsMessaging, "SimpMessagingTemplate", "Spring WebSocket", "Публикация в /topic/components")

    Component(mappers, "Static DTO Mappers", "AutoComponentMapper, FavouriteMapper", "Преобразование Entity ↔ DTO (статические вызовы)")

    Component(componentRepo, "AutoComponentRepository", "Spring Data JPA", "CRUD для AutoComponent")
    Component(favouriteRepo, "FavouriteRepository", "Spring Data JPA", "CRUD и выборка избранного")
    Component(userRepo, "UserRepository", "Spring Data JPA", "CRUD для User")
    Component(outboxRepo, "OutboxEventRepository", "Spring Data JPA", "CRUD для outbox_event")
    Component(descriptionVersionRepo, "AutoComponentDescriptionVersionRepository", "Spring Data MongoDB", "Хранение версий описаний")
    Component(mongoTemplate, "MongoTemplate", "Spring Data MongoDB", "Счётчик версий в Mongo")
}

ContainerDb(postgres, "PostgreSQL", "Relational DB", "auto_component, favourites, users, outbox_event")
ContainerDb(mongo, "MongoDB", "Document DB", "auto_component_description_versions, auto_component_version_counters")
System_Ext(kafka, "Kafka", "topics: component-events, auto-component-updated")

Rel(client, apiControllers, "Вызывает endpoints", "HTTP/JSON")
Rel(client, wsMessaging, "Получает события", "WebSocket/STOMP (/ws, /topic/components)")

Rel(apiControllers, componentService, "Использует")
Rel(apiControllers, favouriteService, "Использует")
Rel(apiControllers, userRepo, "Читает пользователей (UserController)")

Rel(componentService, componentRepo, "Сохраняет/читает AutoComponent")
Rel(componentService, createdProducer, "Публикует событие при CREATE")
Rel(componentService, outboxService, "Пишет событие при EDIT")
Rel(componentService, mappers, "Формирует DTO")

Rel(favouriteService, favouriteRepo, "Сохраняет/читает Favourite")
Rel(favouriteService, componentRepo, "Проверяет существование компонента")
Rel(favouriteService, mappers, "Формирут DTO")

Rel(outboxService, outboxRepo, "Сохраняет outbox-событие")
Rel(outboxRelay, outboxRepo, "Читает непубликованные / помечает статус")
Rel(outboxRelay, kafka, "Публикует ComponentUpdatedEvent", "topic auto-component-updated")

Rel(createdProducer, kafka, "Публикует ComponentCreatedEvent", "topic component-events")
Rel(kafka, createdConsumer, "Доставляет ComponentCreatedEvent", "Kafka Listener")
Rel(createdConsumer, wsMessaging, "Публикует в /topic/components")

Rel(kafka, versionService, "Доставляет ComponentUpdatedEvent", "Kafka Listener")
Rel(versionService, descriptionVersionRepo, "Сохраняет версии описаний")
Rel(versionService, mongoTemplate, "Инкрементирует счётчик версий")

Rel(componentRepo, postgres, "JPA/Hibernate")
Rel(favouriteRepo, postgres, "JPA/Hibernate")
Rel(userRepo, postgres, "JPA/Hibernate")
Rel(outboxRepo, postgres, "JPA/Hibernate")
Rel(descriptionVersionRepo, mongo, "Spring Data MongoDB")
Rel(mongoTemplate, mongo, "Mongo operations")

@enduml
